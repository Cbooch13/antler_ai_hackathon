{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://austin-build-feasibility.local/schemas/core.schema.json",
  "title": "Austin Build Feasibility Core Schemas",
  "$defs": {
    "Confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "MetricBasis": {
      "type": "string",
      "enum": ["known", "estimated", "public_data_pending", "unknown"]
    },
    "SourceMetadata": {
      "type": "object",
      "required": ["sourceName", "sourceUrl", "retrievedAt", "confidence"],
      "additionalProperties": false,
      "properties": {
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "licenseName": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        }
      }
    },
    "Listing": {
      "type": "object",
      "required": [
        "listingId",
        "address",
        "priceUsd",
        "sourceMode",
        "currentInventory",
        "units",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "listingId": { "type": "string", "minLength": 1 },
        "parcelId": { "type": "string" },
        "address": { "type": "string", "minLength": 1 },
        "neighborhood": { "type": "string" },
        "priceUsd": { "type": "number", "exclusiveMinimum": 0 },
        "lotSqft": { "type": "number", "exclusiveMinimum": 0 },
        "buildingSqft": { "type": "number", "exclusiveMinimum": 0 },
        "bedrooms": { "type": "integer", "minimum": 0 },
        "bathrooms": { "type": "number", "minimum": 0 },
        "units": { "type": "integer", "minimum": 1 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "sourceMode": {
          "type": "string",
          "enum": [
            "licensed",
            "prototype_static_dataset",
            "prototype_apify",
            "manual",
            "public"
          ]
        },
        "currentInventory": { "type": "boolean" },
        "dataYear": { "type": "integer" },
        "prototypeNote": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/SourceMetadata" }
        }
      }
    },
    "MapContext": {
      "type": "object",
      "required": ["mapProvider", "warnings"],
      "additionalProperties": false,
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "mapProvider": { "type": "string" },
        "aerialImageUrl": { "type": "string" },
        "streetViewUrl": { "type": "string" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "PermitRecord": {
      "type": "object",
      "required": ["permitId", "raw", "sources"],
      "additionalProperties": false,
      "properties": {
        "permitId": { "type": "string", "minLength": 1 },
        "permitType": { "type": "string" },
        "workClass": { "type": "string" },
        "status": { "type": "string" },
        "issueDate": { "type": "string" },
        "expirationDate": { "type": "string" },
        "address": { "type": "string" },
        "description": { "type": "string" },
        "squareFeet": { "type": "number", "minimum": 0 },
        "valuationUsd": { "type": "number", "minimum": 0 },
        "units": { "type": "integer", "minimum": 0 },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "raw": { "type": "object" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/SourceMetadata" }
        }
      }
    },
    "GisFeatureRecord": {
      "type": "object",
      "required": ["featureId", "layerName", "attributes", "sources"],
      "additionalProperties": false,
      "properties": {
        "featureId": { "type": "string", "minLength": 1 },
        "layerName": { "type": "string", "minLength": 1 },
        "attributes": { "type": "object" },
        "geometry": { "type": "object" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/SourceMetadata" }
        }
      }
    },
    "UserBuildSpec": {
      "type": "object",
      "required": [
        "projectName",
        "city",
        "state",
        "propertyType",
        "totalBudgetUsd",
        "units",
        "riskTolerance"
      ],
      "additionalProperties": false,
      "properties": {
        "projectName": { "type": "string", "minLength": 1 },
        "city": { "const": "Austin" },
        "state": { "const": "TX" },
        "propertyType": {
          "type": "string",
          "enum": ["single_family", "adu", "duplex_triplex", "commercial"]
        },
        "totalBudgetUsd": { "type": "number", "exclusiveMinimum": 0 },
        "targetLotSqft": { "type": "number", "exclusiveMinimum": 0 },
        "targetBuildingSqft": { "type": "number", "exclusiveMinimum": 0 },
        "bedrooms": { "type": "integer", "minimum": 0 },
        "bathrooms": { "type": "number", "minimum": 0 },
        "units": { "type": "integer", "minimum": 1 },
        "stylePreferences": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "riskTolerance": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      }
    },
    "ComplianceFinding": {
      "type": "object",
      "required": [
        "code",
        "title",
        "status",
        "summary",
        "confidence",
        "professionalVerificationRequired",
        "citations"
      ],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["passes", "fails", "warning", "unknown"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "professionalVerificationRequired": { "type": "boolean" },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/SourceMetadata" }
        }
      }
    },
    "ComplianceMetric": {
      "type": "object",
      "required": ["category", "label", "value", "basis", "status", "confidence", "source"],
      "additionalProperties": false,
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "basis": { "$ref": "#/$defs/MetricBasis" },
        "status": {
          "type": "string",
          "enum": ["passes", "fails", "warning", "unknown"]
        },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "source": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    }
  }
}
